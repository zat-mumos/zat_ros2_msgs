# RagLanguageGame.srv - Service for sending and received request to a llm server

# Authors: 
# Oviya Rajavel <oviya.rajavel@smail.inf.h-brs.de>


std_msgs/Header header

# id - ID of the question
int32 id
# question - Current question
string question
# available_answers - Array of possible answers for the question
GameAnswer[] available_answers
# student_answer_type - Type of answer expected from the student
string student_answer_type

---

# id - ID of the selected answer
int32 id
# type - Type of the answer
string type
# content - Content of the answer
string content