# GetAverageEngagement.action - Action message which includes start and end time along with the average engagement scores
# timestamps and feedback message

# Author:  Michal Stolarz <michal.stolarz@h-brs.de>

# goal
# start_time - records the start timestamp
float64 start_time
# end_time - records the end timestamp
float64 end_time
---
# result
# timestamps - Array of timestamps
float64[] timestamps
# avg_engagement - Array of average engagement scores
float64[] avg_engagement
---
# feedback
# feedback_msg - Feedback message
string feedback_msg